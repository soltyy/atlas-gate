[Unit]
Description=Refresh managed API and exact steering contracts after Gate startup
After=atlas-gate.service

[Service]
Type=oneshot
User=root
TimeoutStartSec=0
ExecStart=/usr/bin/flock /run/lock/atlas-deploy.lock /opt/atlas/gate/.venv/bin/python /usr/local/sbin/atlas-gate-deploy --refresh-api-contract
