[Unit]
Description=Router file uploads through a separate SSH connection via Finland
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=exec
User=atlas-router-link
ExecStart=/usr/bin/ssh -NT -F /etc/atlas/router-standby/ssh_config_files atlas-files-router
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
