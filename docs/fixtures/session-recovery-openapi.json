  "components": {
    "schemas": {
      "Ack": {
        "properties": {
          "version": {
            "type": "integer",
            "const": 1,
            "title": "Version"
          },
          "ackKey": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Ackkey"
          },
          "planId": {
            "type": "string",
            "title": "Planid"
          },
          "planRevision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Planrevision"
          },
          "sourceManifestSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sourcemanifestsha256"
          },
          "clientStoreEpoch": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Clientstoreepoch"
          },
          "sourceRunId": {
            "type": "string",
            "title": "Sourcerunid"
          },
          "sourceSessionId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sourcesessionid"
          },
          "sourceAttemptId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sourceattemptid"
          },
          "sourceCheckpointVersion": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Sourcecheckpointversion"
          },
          "appliedActions": {
            "items": {
              "$ref": "#/components/schemas/AppliedAction"
            },
            "type": "array",
            "minItems": 1,
            "title": "Appliedactions"
          },
          "localCommitRef": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Localcommitref"
          },
          "localCommitSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Localcommitsha256"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "ackKey",
          "planId",
          "planRevision",
          "sourceManifestSha256",
          "clientStoreEpoch",
          "sourceRunId",
          "sourceCheckpointVersion",
          "appliedActions",
          "localCommitRef",
          "localCommitSha256"
        ],
        "title": "Ack"
      },
      "ApiAttemptReconcile": {
        "properties": {
          "version": {
            "type": "integer",
            "const": 1,
            "title": "Version"
          },
          "requestId": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Requestid"
          },
          "routeId": {
            "type": "string",
