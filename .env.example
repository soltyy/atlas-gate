# Пример; секреты заменяет администратор. Не добавлять рабочий .env в Git.
ATLAS_HOST=127.0.0.1
ATLAS_PORT=8766
ATLAS_TOKEN=REPLACE_ADMIN_TOKEN
ATLAS_TRUST_LOCAL=false
ATLAS_GATE_KEYRING_SECRET=REPLACE_KEYRING_SECRET
ATLAS_GATE_DB=gate/gate.db
ATLAS_GATE_KEY_PATH=gate/signing-key.pem
ATLAS_GATE_ORGS_DIR=gate/orgs
ATLAS_GATE_NODES_FILE=gate/nodes.json
ATLAS_GATE_NODE_ENV_FILE=gate/node-secrets.env
ATLAS_GATE_NODE_PKI_DIR=gate/node-pki
# Внешний origin прежнего Gate: профили устройств сохраняют централизованный URL.
ATLAS_GATE_PUBLIC_URL=https://gate.example
# Для NAT production нужен отдельный mTLS listener. CLI atlas-gate запускает оба порта.
ATLAS_GATE_NODE_TLS_PORT=0
ATLAS_GATE_NODE_TLS_CERT=
ATLAS_GATE_NODE_TLS_KEY=
ATLAS_GATE_NODE_TLS_CA=
